        <mxCell id="gz" value="GAZEBO HARMONIC&#xa;&#xa;• DART Physics (1000 Hz step)&#xa;• airport_runway / nus_ea_field&#xa;• Scout 2.0 URDF diff-drive plugin&#xa;• GPU LiDAR, Camera, IMU, GPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F43F5E;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
