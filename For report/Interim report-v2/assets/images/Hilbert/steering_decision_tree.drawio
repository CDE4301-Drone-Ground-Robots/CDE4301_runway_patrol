<mxfile host="app.diagrams.net" modified="2026-10-28T04:20:00.000Z" agent="drawio-mcp" version="24.0.0">
  <diagram id="page-1" name="Steering Architecture Decision Tree"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    
    <!-- Title Header -->
    <mxCell id="title" value="&lt;b&gt;Airside Steering Architecture Selection &amp; Decision Matrix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;CDE4301 Runway Patrol • Hilbert Soh (A0308263H)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
    </mxCell>

    <!-- Root Problem Definition -->
    <mxCell id="root_req" value="&lt;b&gt;Airside FOD Mission Requirements&lt;/b&gt;&lt;hr&gt;• Transit Speed: 10–15 km/h&lt;br&gt;• Surface: Grooved Asphalt &amp; Loose Bitumen&lt;br&gt;• Target Alignment: Zero-Radius Micro-Positioning&lt;br&gt;• Vacuum Module: Fixed 45 mm Standoff&lt;br&gt;• Perception: Low Vibration for 3D LiDAR/IMU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="450" y="80" width="300" height="110" as="geometry" />
    </mxCell>

    <!-- Candidate 1: Ackermann -->
    <mxCell id="cand_ack" value="&lt;b&gt;Candidate 1: Ackermann Steering&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;Car-Like Knuckle Steering (2 DOF)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#f8fafc;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="80" y="240" width="280" height="50" as="geometry" />
    </mxCell>

    <!-- Candidate 1 Evaluation -->
    <mxCell id="eval_ack" value="&lt;b&gt;Architecture Evaluation:&lt;/b&gt;&lt;br&gt;• R_min ≥ 0.79 m (Swept Circle &gt; 2.4 m)&lt;br&gt;• Cannot pivot in-place over detected debris&lt;br&gt;• Body lean in turns varies suction standoff&lt;br&gt;• Steering linkages suffer vibration fatigue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#475569;fontColor=#cbd5e1;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="80" y="310" width="280" height="90" as="geometry" />
    </mxCell>

    <!-- Candidate 1 Verdict -->
    <mxCell id="verdict_ack" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;Overshooting debris forces multi-point shunting; kinematic radius too large." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;fontColor=#ffe4e6;fontSize=12;align=center;" vertex="1" parent="1">
      <mxGeometry x="80" y="420" width="280" height="60" as="geometry" />
    </mxCell>

    <!-- Candidate 2: 4WD Differential Drive (Skid-Steer) -->
    <mxCell id="cand_diff" value="&lt;b&gt;Candidate 2: 4WD Differential Drive (Skid)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;Independent Hub Differential (2 DOF Non-Holonomic)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;strokeWidth=2.5;fontColor=#f8fafc;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="450" y="240" width="300" height="50" as="geometry" />
    </mxCell>

    <!-- Candidate 2 Evaluation -->
    <mxCell id="eval_diff" value="&lt;b&gt;Architecture Evaluation:&lt;/b&gt;&lt;br&gt;• Zero-Radius turning (R = 0 m) allows micro-adjustment&lt;br&gt;• Fixed 45 mm chassis ground clearance seals vacuum hood&lt;br&gt;• Direct-drive hub motors eliminate steering linkages&lt;br&gt;• Sized to 0.80 ≤ L/B ≤ 1.00 corridor (no spinout / tip-over)&lt;br&gt;• Skid-steer non-holonomic slip fused via Dual EKF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#10b981;fontColor=#e2e8f0;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="450" y="310" width="300" height="110" as="geometry" />
    </mxCell>

    <!-- Candidate 2 Verdict -->
    <mxCell id="verdict_diff" value="&lt;b&gt;SELECTED ARCHITECTURE&lt;/b&gt;&lt;br&gt;Meets all 5 airside criteria. Optimal balance of zero-radius pivoting, direct-drive reliability, and constant ground clearance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2.5;fontColor=#ecfdf5;fontSize=12;align=center;" vertex="1" parent="1">
      <mxGeometry x="450" y="440" width="300" height="70" as="geometry" />
    </mxCell>

    <!-- Candidate 3: Mecanum Wheel Drive -->
    <mxCell id="cand_mec" value="&lt;b&gt;Candidate 3: Mecanum Wheel Drive&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;45° Angled Sub-Rollers (3 DOF Holonomic)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#f8fafc;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="840" y="240" width="280" height="50" as="geometry" />
    </mxCell>

    <!-- Candidate 3 Evaluation -->
    <mxCell id="eval_mec" value="&lt;b&gt;Architecture Evaluation:&lt;/b&gt;&lt;br&gt;• High vibration (30–80 Hz) degrades 3D LiDAR SLAM&lt;br&gt;• Loose tarmac aggregate/gravel jams peripheral rollers&lt;br&gt;• Poor traction (μ_eff ≈ 0.35–0.45) on wet/sloped runway&lt;br&gt;• Severe roller wear on abrasive airport asphalt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#475569;fontColor=#cbd5e1;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="840" y="310" width="280" height="90" as="geometry" />
    </mxCell>

    <!-- Candidate 3 Verdict -->
    <mxCell id="verdict_mec" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;Environmental unreliability on abrasive airside tarmac; high failure rate from roller jamming." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fef3c7;fontSize=12;align=center;" vertex="1" parent="1">
      <mxGeometry x="840" y="420" width="280" height="60" as="geometry" />
    </mxCell>

    <!-- Edges from Root to Candidates -->
    <mxCell id="edge1" edge="1" parent="1" source="root_req" target="cand_ack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge2" edge="1" parent="1" source="root_req" target="cand_diff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=3;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge3" edge="1" parent="1" source="root_req" target="cand_mec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Edges from Candidate to Eval -->
    <mxCell id="edge_ack_eval" edge="1" parent="1" source="cand_ack" target="eval_ack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="edge_ack_verdict" edge="1" parent="1" source="eval_ack" target="verdict_ack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f43f5e;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_diff_eval" edge="1" parent="1" source="cand_diff" target="eval_diff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10b981;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="edge_diff_verdict" edge="1" parent="1" source="eval_diff" target="verdict_diff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10b981;strokeWidth=2.5;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_mec_eval" edge="1" parent="1" source="cand_mec" target="eval_mec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="edge_mec_verdict" edge="1" parent="1" source="eval_mec" target="verdict_mec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f59e0b;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel></diagram>
