        <mxCell id="title" value="Nav2 SmacPlannerHybrid &amp; Regulated Pure Pursuit (RPP) Topology" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="bt" value="nav2_bt_navigator (Behavior Tree Navigator)&#xa;Action: NavigateToPose | Recovery: ClearCostmap, Spin, Wait, BackUp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1020" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="planner" value="Global Planner: SmacPlannerHybrid (Hybrid A*)&#xa;&#xa;• Motion Model: REEDS_SHEPP (SE(2) lattice)&#xa;• Turning Radius: R_min = 1.0 m&#xa;• Reverse Penalty: 2.5&#xa;• 64 Angle Quantization Bins&#xa;• Prevents abrupt pivot turns on tarmac&#xa;&#xa;Global Costmap: 5 cm resolution, static orthophoto + 3D LiDAR layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#FBBF24;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="480" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="controller" value="Local Controller: Regulated Pure Pursuit (RPP)&#xa;&#xa;• Lookahead: L = 1.2 m (scaled by speed: L = max(0.4, v*1.2))&#xa;• Desired Linear Velocity: 2.22 m/s&#xa;• Curvature Velocity Scaling: R_min = 0.8 m&#xa;• Cost Proximity Deceleration: d_cost = 1.0 m&#xa;• Deterministic 20 Hz update | 2-5% CPU footprint&#xa;&#xa;Output: /cmd_vel (v_x, omega_z) -&gt; 4WD Skid IK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#34D399;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="580" y="180" width="480" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="e_bt_p" edge="1" source="bt" target="planner" parent="1"/>
        <mxCell id="e_p_c" value="nav_msgs/Path" edge="1" source="planner" target="controller" parent="1"/>
      </root>
    </mxGraphModel>
