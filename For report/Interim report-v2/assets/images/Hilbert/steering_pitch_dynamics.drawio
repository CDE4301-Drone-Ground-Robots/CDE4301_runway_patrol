<mxfile host="app.diagrams.net" modified="2026-10-28T06:00:00.000Z" agent="drawio-mcp" version="24.0.0">
  <diagram id="pitch-dyn" name="Longitudinal Pitch Dynamics">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="side_chassis" value="&lt;b&gt;CHASSIS PROFILE&lt;/b&gt;&lt;br&gt;m = 65.0 kg&lt;br&gt;Wheelbase L = 488.8 mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="side_cg" value="CG&lt;br&gt;h_cg = 200 mm" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#38bdf8;fontColor=#0f172a;strokeColor=#0284c7;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="160" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wheel_f" value="Front Axle&lt;br&gt;N_front = mg/2 - Delta N" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#020617;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wheel_r" value="Rear Axle&lt;br&gt;N_rear = mg/2 + Delta N" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#020617;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;" vertex="1" parent="1">
          <mxGeometry x="580" y="300" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pitch_formula" value="&lt;b&gt;LIFT-OFF PREVENTION INEQUALITY&lt;/b&gt;&lt;br&gt;Delta N = (m * a * h_cg) / L &lt; mg / 2&lt;br&gt;&lt;b&gt;L/B &gt;= 2 * (h_cg / B) * (a / g) &gt;= 0.80&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#10b981;strokeWidth=1.5;fontColor=#10b981;" vertex="1" parent="1">
          <mxGeometry x="270" y="50" width="360" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
