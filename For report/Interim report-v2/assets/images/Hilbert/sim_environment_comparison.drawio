        <mxCell id="title" value="Simulation Environment Comparison: Aarhus Airport vs NUS EA Field" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="aarhus" value="AARHUS AIRPORT (EKAH)&#xa;&#xa;• Macro scale: 300 m x 200 m operating area&#xa;• Resolution: 0.10 m/px (6 MB map)&#xa;• Tested runway scale &amp; AMCL failure&#xa;• Synthetic airfield waypoint cubes&#xa;• High GPU load &amp; no physical access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="480" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="nus_ea" value="NUS EA FIELD COURTYARD&#xa;&#xa;• Physical campus bounds: 52.2 m x 29.1 m&#xa;• Ultra-high res: 0.028 m/px (~2.8 cm/cell)&#xa;• Exact drone orthophoto ground plane&#xa;• RTF = 0.95 - 1.0 on local workstation&#xa;• Directly accessible testbed for S2 physical trials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#34D399;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="480" height="360" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
