    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArduSimple - 高精度厘米级GNSS RTK解决方案 </title>
    <meta name="description"
        content="ArduSimple 为中国市场提供简单、实惠且具备厘米级精度的 GNSS RTK 解决方案。提供 u-blox 接收机、多频天线及技术支持，助力精准农业、无人机和机器人应用。">
    <meta name="keywords" content="ArduSimple, RTK, GNSS, 高精度GPS, 厘米级定位, u-blox, 机器人GPS, 精准农业">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.ardusimple.cn/">
    <meta property="og:title" content="ArduSimple China - 高精度厘米级 GNSS RTK">
    <meta property="og:description" content="厘米级定位技术从未如此简单。直接发货至中国，提供完整技术支持。">
    <meta property="og:image" content="ardusimple_logo.svg">

    <link rel="icon" type="image/png" href="favicon.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #333;
            background: #fff;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        a:hover {
            text-decoration: underline;
        }

        /* Preheader */
        .preheader {
            background: #1a1a1a;
            color: #ccc;
            font-size: 13px;
            padding: 8px 0;
        }

        .preheader .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .preheader-left {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .preheader-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .china-flag {
            width: 20px;
            height: auto;
            display: inline-block;
            vertical-align: middle;
            margin-right: 4px;
        }

        /* Header */
        .main-header {
            background: #fff;
            border-bottom: 1px solid #eee;
            padding: 15px 0;
        }

        .main-header .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .logo img {
            height: 42px;
            width: auto;
            display: block;
        }

        .main-menu {
            display: flex;
            gap: 36px;
            font-weight: 500;
            font-size: 15px;
        }

        .main-menu a:hover {
            color: #6ec1e4;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 14px;
        }

        .search-box {
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 9px 14px;
            width: 240px;
            font-size: 14px;
            color: #999;
            background: #f9f9f9;
        }

        .cart {
            position: relative;
            font-size: 20px;
        }

        .cart-count {
            position: absolute;
            top: -10px;
            right: -12px;
            background: #e74c3c;
            color: white;
            font-size: 10px;
            min-width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
        }

        /* Main content */
        .main-content {
            max-width: 1200px;
            margin: 50px auto;
            padding: 0 20px;
        }

        .notice-box {
            background: #fff8e1;
            border: 1px solid #ffe082;
            padding: 32px;
            border-radius: 8px;
            margin-bottom: 50px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
            margin: 40px 0;
        }

        .product-card {
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 24px;
            text-align: center;
            background: #fff;
        }

        .product-card img {
            max-width: 100%;
            height: auto;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .btn-quote {
            display: inline-block;
            background: #6ec1e4;
            color: white;
            padding: 14px 32px;
            border-radius: 30px;
            font-weight: 500;
            margin: 30px 0;
            font-size: 16px;
        }

        .btn-quote:hover {
            background: #5aa8d0;
            text-decoration: none;
        }

        /* Footer - estil inline tal com l'has proporcionat */
        footer {
            background: #000;
            color: #aaa;
            padding: 60px 0 30px;
            font-size: 14px;
            line-height: 1.6;
        }

        /* Responsive adjustments */
        @media (max-width: 1024px) {

            .preheader .container,
            .main-header .container {
                flex-direction: column;
                gap: 15px;
            }

            .main-menu {
                gap: 20px;
                flex-wrap: wrap;
                justify-content: center;
            }

            .header-right {
                justify-content: center;
                gap: 20px;
            }

            .search-box {
                width: 100%;
                max-width: 400px;
            }

            footer .footer-container>div:first-child>div:first-child {
                flex-direction: column;
                text-align: center;
            }
        }

        @media (max-width: 768px) {
            .preheader {
                font-size: 12px;
                padding: 10px 0;
            }

            .preheader-left {
                flex-direction: column;
                text-align: center;
                gap: 6px;
            }

            .logo img {
                height: 36px;
            }

            .main-menu {
                flex-direction: column;
                gap: 12px;
                font-size: 14px;
            }

            .header-right {
                flex-direction: column;
                gap: 12px;
            }

            .search-box {
                width: 100%;
            }

            .main-content {
                margin: 30px auto;
                padding: 0 15px;
            }

            .notice-box {
                padding: 24px;
            }

            .products-grid {
                grid-template-columns: 1fr;
            }

            .btn-quote {
                width: 100%;
                text-align: center;
            }

            footer {
                padding: 40px 0 20px;
            }

            footer [style*="display:grid"] {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            footer [style*="display:flex"] {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
        }

        @media (max-width: 480px) {
            .preheader {
                font-size: 11px;
            }

            .china-flag {
                width: 18px;
            }

            footer h4 {
                font-size: 15px;
            }

            footer input,
            footer button {
                font-size: 13px;
                padding: 9px 12px;
            }
        }
    </style>
