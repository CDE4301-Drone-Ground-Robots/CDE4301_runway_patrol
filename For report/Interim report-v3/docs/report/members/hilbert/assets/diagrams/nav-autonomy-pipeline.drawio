<mxfile host="app.diagrams.net" modified="2026-10-28T07:00:00.000Z" agent="Mozilla/5.0" version="24.0.0">
  <diagram id="autonomy_pipeline" name="Autonomy Control Pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CDE4301 FOD Hunter UGV: 5-Stage Autonomy Control Pipeline" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="stage1" value="1. PERCEPTION&#xa;&#xa;• Hesai JT16 3D LiDAR (Selected)&#xa;  (30m range, 360x40 deg, 100k lux)&#xa;• Intel RealSense D435 Camera&#xa;• Gazebo GPU LaserScan (Sim)&#xa;&#xa;Interfaces: /scan, /points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="180" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="stage2" value="2. LOCALIZATION&#xa;&#xa;• Local EKF (30 Hz):&#xa;  Fused /odom + /imu/data&#xa;  Publishes odom -&gt; base_footprint&#xa;&#xa;• Global EKF (30 Hz):&#xa;  Fused local odom + RTK-GPS&#xa;  Publishes map -&gt; odom&#xa;&#xa;AMCL degenerate on featureless runway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#C084FC;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="180" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="stage3" value="3. PLANNING&#xa;&#xa;• Nav2 BT Navigator:&#xa;  NavigateToPose action server&#xa;&#xa;• SmacPlannerHybrid:&#xa;  Continuous SE(2) lattice&#xa;  Reeds-Shepp model (R_min=1.0m)&#xa;  Prevents high-torque pivot turns&#xa;&#xa;• 5cm Global &amp; Local Costmaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#FBBF24;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="180" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="stage4" value="4. CONTROL&#xa;&#xa;• Regulated Pure Pursuit (RPP):&#xa;  Lookahead L = 1.2 m&#xa;  Max speed = 2.22 m/s&#xa;  Curvature scaling (R_min=0.8m)&#xa;  Proximity deceleration (d=1.0m)&#xa;  Low CPU: 2-5%&#xa;&#xa;Output: /cmd_vel (v_x, omega_z)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#34D399;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="180" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="stage5" value="5. ACTUATION&#xa;&#xa;• 4WD Skid-Steer IK Model&#xa;• STM32 CANopen Bridge&#xa;• Dual ZLAC8015D Drivers&#xa;• 4x Direct-Drive Hub Motors&#xa;  (ZLLG80ASM250, 48V, 250W ea)&#xa;  R = 0.1315 m, W = 0.58 m&#xa;• Rear Vacuum Intake Head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F43F5E;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="920" y="80" width="180" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="e1" edge="1" source="stage1" target="stage2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" edge="1" source="stage2" target="stage3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" edge="1" source="stage3" target="stage4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" edge="1" source="stage4" target="stage5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
