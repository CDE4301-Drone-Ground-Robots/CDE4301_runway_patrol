  <diagram id="sim_workflow" name="Simulation Development Workflow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Closed-Loop Robotics Simulation Development Workflow (Slide 29)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1. ROBOT MODEL&#xa;&#xa;• Scout 2.0 Proxy (52.4 kg)&#xa;• Unblocks Nav2/C2 software&#xa;• URDF, diff-drive, inertia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="150" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2. PHYSICS ENGINE&#xa;&#xa;• Gazebo Harmonic DART&#xa;• 1.0 ms step size (1000 Hz)&#xa;• Coulomb tarmac friction mu=0.8&#xa;• Rigid contact approximation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#C084FC;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="150" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3. SYNTHETIC SENSORS&#xa;&#xa;• GPU LiDAR (/scan)&#xa;• RealSense Camera&#xa;• IMU (100 Hz, noise)&#xa;• NavSat GPS (5 Hz, ±2cm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#FBBF24;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="150" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4. ROS 2 CONTROL&#xa;&#xa;• ros_gz_bridge (/clock synch)&#xa;• SmacPlannerHybrid&#xa;• Regulated Pure Pursuit (20Hz)&#xa;• Dual-EKF state estimation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#34D399;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="150" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5. SIL EVALUATION&#xa;&#xa;• Aarhus Runway (EKAH)&#xa;• NUS EA Field (52x29 m)&#xa;• Waypoint sweeps &amp; evasion&#xa;• 25 structured test runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F43F5E;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="150" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="6. SIM2REAL ITERATION&#xa;&#xa;• Physical custom UGV&#xa;• 4x hub motors (48V)&#xa;• Sensor calibration&#xa;• On-site tarmac trials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="940" y="80" width="150" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="e1" edge="1" source="s1" target="s2" parent="1"/>
        <mxCell id="e2" edge="1" source="s2" target="s3" parent="1"/>
