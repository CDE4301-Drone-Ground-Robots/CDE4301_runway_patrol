{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@docs/*": ["./docs/*"],
      "@theme/*": ["./docs/.vitepress/theme/*"]
    },
    "strict": false,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "env.d.ts",
    "docs/.vitepress/env.d.ts",
    "docs/.vitepress/**/*"
  ],
  "exclude": [
    "docs/.vitepress/cache",
    "docs/.vitepress/dist",
    "node_modules"
  ]
}
