<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="airport_runway_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>56.3000</latitude_deg>
      <longitude_deg>10.6190</longitude_deg>
      <elevation>25.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Airport Ground Plane shifted by +160m so the runway centerline is at Gazebo origin (0,0) -->
    <include>
      <uri>model://airport_ground_plane</uri>
      <pose>0 160.0 0 0 0 0</pose>
    </include>

    <!-- Inspection FOD Targets on Runway: Tiny Pink Cubes (height 0.03m, too short for LiDAR at 0.45m to detect) -->
    <!-- Waypoint 1 Target -->
    <model name="pink_cube_wp1">
      <static>true</static>
      <pose>-7.57 -29.64 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.65 1.0</ambient>
            <diffuse>1.0 0.15 0.65 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.3 0.05 0.2 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint 2 Target -->
    <model name="pink_cube_wp2">
      <static>true</static>
      <pose>-2.92 -11.94 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.65 1.0</ambient>
            <diffuse>1.0 0.15 0.65 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.3 0.05 0.2 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint 3 Target -->
    <model name="pink_cube_wp3">
      <static>true</static>
      <pose>39.63 -5.93 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.65 1.0</ambient>
            <diffuse>1.0 0.15 0.65 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.3 0.05 0.2 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint 4 Target -->
    <model name="pink_cube_wp4">
      <static>true</static>
      <pose>15.83 0.06 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.65 1.0</ambient>
            <diffuse>1.0 0.15 0.65 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.3 0.05 0.2 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint 5 Target -->
    <model name="pink_cube_wp5">
      <static>true</static>
      <pose>7.75 0.15 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.65 1.0</ambient>
            <diffuse>1.0 0.15 0.65 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.3 0.05 0.2 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Additional Demo FOD Cubes -->
    <model name="pink_cube_fod_a">
      <static>true</static>
      <pose>8.0 -1.8 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.65 1.0</ambient>
            <diffuse>1.0 0.15 0.65 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.3 0.05 0.2 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="pink_cube_fod_b">
      <static>true</static>
      <pose>16.0 -3.7 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.03</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.65 1.0</ambient>
            <diffuse>1.0 0.15 0.65 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.3 0.05 0.2 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
