<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="scout_wheel">

    <xacro:macro name="scout_wheel_type2" params="wheel_prefix axis_xyz *joint_pose">
        <link name="${wheel_prefix}_wheel_link">
            <inertial>
                <mass value="3.0" />
                <origin xyz="0 0 0" />
                <inertia ixx="0.0237" ixy="0" ixz="0" iyy="0.0406" iyz="0" izz="0.0237" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://runway_description/meshes/wheel_type2.dae" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" />
                <geometry>
                    <cylinder length="${wheel_length}" radius="${wheel_radius}" />
                </geometry>
            </collision>
        </link>

        <joint name="${wheel_prefix}_wheel" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_prefix}_wheel_link"/>
            <xacro:insert_block name="joint_pose"/>
            <axis xyz="${axis_xyz}" rpy="0 0 0" />
            <dynamics damping="0.01" friction="0.01"/>
        </joint>

        <gazebo reference="${wheel_prefix}_wheel_link">
            <mu1>1.2</mu1>
            <mu2>0.2</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>
            <fdir1>1 0 0</fdir1>
        </gazebo>
    </xacro:macro>

</robot>
