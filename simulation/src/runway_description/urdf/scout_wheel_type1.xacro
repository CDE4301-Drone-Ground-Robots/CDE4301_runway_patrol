<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="scout_wheel">

    <xacro:macro name="scout_wheel_type1" params="wheel_prefix axis_xyz *joint_pose">
        <link name="${wheel_prefix}_wheel_link">
            <inertial>
                <mass value="3.0" />
                <origin xyz="0 0 0" />
                <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://runway_description/meshes/wheel_type1.dae" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" />
                <geometry>
                    <cylinder length="${wheel_length}" radius="${wheel_radius}" />
                </geometry>
            </collision>
        </link>

        <joint name="${wheel_prefix}_wheel" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_prefix}_wheel_link"/>
            <xacro:insert_block name="joint_pose"/>
            <axis xyz="${axis_xyz}" rpy="0 0 0" />
        </joint>

        <gazebo reference="${wheel_prefix}_wheel_link">
            <mu1 value="1.0"/>
            <mu2 value="0.1"/>
            <fdir1 value="1 0 0"/>
            <kp value="500000.0" />
            <kd value="10.0" />
            <minDepth>0.005</minDepth>
        </gazebo>
    </xacro:macro>
    
</robot>
