<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.8">
   <model name="airport_ground_plane">
      <static>true</static>
      <link name="link">
         <collision name="collision">
            <geometry>
               <plane>
                  <normal>0 0 1</normal>
                  <size>3700 2000</size>
               </plane>
            </geometry>
            <surface>
               <friction>
                  <ode>
                     <mu>100</mu>
                     <mu2>50</mu2>
                  </ode>
               </friction>
            </surface>
         </collision>
         <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry>
               <plane>
                  <normal>0 0 1</normal>
                  <size>3700 2000</size>
               </plane>
            </geometry>
            <material>
               <ambient>0.8 0.8 0.8 1.0</ambient>
               <diffuse>0.8 0.8 0.8 1.0</diffuse>
               <specular>0.1 0.1 0.1 1.0</specular>
               <pbr>
                  <metal>
                     <albedo_map>model://airport_ground_plane/materials/textures/airport.png</albedo_map>
                  </metal>
               </pbr>
               <script>
                  <uri>model://airport_ground_plane/materials/scripts</uri>
                  <uri>model://airport_ground_plane/materials/textures/</uri>
                  <name>AirportGroundPlane/Image</name>
               </script>
            </material>
         </visual>
      </link>
   </model>
</sdf>
