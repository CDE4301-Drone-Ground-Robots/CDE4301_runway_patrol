<?xml version="1.0"?>
<sdf version="1.9">
  <model name="runway_person">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- Body (torso + legs as a cylinder) -->
    <link name="body">
      <pose>0 0 0.85 0 0 0</pose>
      <visual name="torso_visual">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>1.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.3 0.7 1.0</ambient>
          <diffuse>0.2 0.3 0.7 1.0</diffuse>
        </material>
      </visual>
      <collision name="torso_collision">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>1.2</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>70.0</mass>
        <inertia>
          <ixx>5.0</ixx><iyy>5.0</iyy><izz>1.0</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Head -->
    <link name="head">
      <pose>0 0 1.6 0 0 0</pose>
      <visual name="head_visual">
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.85 0.7 0.55 1.0</ambient>
          <diffuse>0.85 0.7 0.55 1.0</diffuse>
        </material>
      </visual>
      <collision name="head_collision">
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
      </collision>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="head_joint" type="fixed">
      <parent>body</parent>
      <child>head</child>
    </joint>
  </model>
</sdf>
