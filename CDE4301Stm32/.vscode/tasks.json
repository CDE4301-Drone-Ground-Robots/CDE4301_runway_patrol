{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: Build (CMake)",
            "type": "shell",
            "command": "cube",
            "args": [
                "cmake",
                "--build",
                "--preset",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "STM32: Flash Firmware (ST-Link)",
            "type": "shell",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "build/Debug/CDE4301Stm32.elf",
                "-v",
                "-rst"
            ],
            "dependsOn": "STM32: Build (CMake)",
            "problemMatcher": []
        },
        {
            "label": "STM32: Flash Prebuilt (No Rebuild)",
            "type": "shell",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "build/Debug/CDE4301Stm32.elf",
                "-v",
                "-rst"
            ],
            "problemMatcher": []
        },
        {
            "label": "STM32: View Output (Serial Monitor)",
            "type": "shell",
            "command": "python -m serial.tools.miniterm COM11 115200",
            "problemMatcher": []
        }
    ]
}
